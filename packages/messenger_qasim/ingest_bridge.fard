import("../messenger_qasim/verify") as verify
import("../messenger_core/digest") as digest
import("std/list") as list

let new_state = fn() { { kind: "qasim_bridge_state_v1", accepted: [], rejected: [], state_digest: digest.digest_text("qasim_bridge_empty") } }
let route = fn(state,content) {
  let v = verify.verify_payload(content.payload) in
  let next_digest = digest.digest_pair(state.state_digest,v.digest_value) in
  if v.ok then { kind: state.kind, accepted: list.concat([state.accepted,[content.payload]]), rejected: state.rejected, state_digest: next_digest }
  else { kind: state.kind, accepted: state.accepted, rejected: list.concat([state.rejected,[content.payload]]), state_digest: state.state_digest }
}
export { new_state, route }
