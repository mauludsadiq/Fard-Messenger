import("../messenger_core/evidence") as evidence
import("../messenger_core/wire") as wire
import("../messenger_core/chain") as chain
import("../messenger_core/content") as content
import("../messenger_core/store") as store
import("../messenger_qasim/ingest_bridge") as qasim_bridge
import("../messenger_fd/registry_bridge") as fd_bridge
import("../messenger_identity/rbac") as rbac
import("std/list") as list

let initial_ctx = fn(admin_key, db) {
  let saved_chain = store.load_chain(db, chain.new_chain("GENESIS").head)
  let base_chain = if saved_chain.count == 0 then chain.new_chain("GENESIS") else saved_chain
  { chain_state: base_chain, qasim: qasim_bridge.new_state(), fd: fd_bridge.new_state(), rbac: rbac.new_table(admin_key), cas_root: "cas", db: db }
}

let send_evidence = fn(ctx, from_identity, to_pk, parent_digest, timestamp_ms, ev) {
  let c = evidence.collapse(ev, ctx.cas_root)
  let w = wire.new_from_content(parent_digest, from_identity, to_pk, timestamp_ms, c)
  let state_digest = content.content_digest(c)
  let res = { ok: true, wire: w, content_digest: state_digest }
  let next_chain = chain.append(ctx.chain_state, ev, res, state_digest)
  let conv = store.conv_id(from_identity.public_key, to_pk)
  let _ = store.save_chain(ctx.db, next_chain)
  let _ = store.save_message(ctx.db, conv, next_chain.count, from_identity.public_key, to_pk, c.kind, state_digest, w.envelope.envelope_digest, next_chain.head, state_digest, w, timestamp_ms)
  { ctx: { chain_state: next_chain, qasim: ctx.qasim, fd: ctx.fd, rbac: ctx.rbac, cas_root: ctx.cas_root, db: ctx.db }, response: res }
}

let send_status = fn(ctx, from_identity, to_pk, status_kind, target_digest, at_ts) {
  let ev = evidence.status_event(status_kind, target_digest, at_ts)
  let c = evidence.collapse(ev, ctx.cas_root)
  let w = wire.new_from_content(ctx.chain_state.head, from_identity, to_pk, at_ts, c)
  let cd = content.content_digest(c)
  let res = { ok: true, wire: w, content_digest: cd, status_kind: status_kind, target_digest: target_digest }
  let next_chain = chain.append(ctx.chain_state, ev, res, cd)
  let conv = store.conv_id(to_pk, from_identity.public_key)
  let _ = store.save_chain(ctx.db, next_chain)
  let _ = store.save_status(ctx.db, conv, from_identity.public_key, status_kind, target_digest, next_chain.head, at_ts)
  { ctx: { chain_state: next_chain, qasim: ctx.qasim, fd: ctx.fd, rbac: ctx.rbac, cas_root: ctx.cas_root, db: ctx.db }, response: res }
}

let accept_wire = fn(ctx, wire_msg) {
  let opened = wire.decrypt_content(wire_msg)
  if opened.ok == false then { ctx: ctx, response: opened } else
  let c = opened.content in
  let qstate = if c.kind == "finance_qasim" then qasim_bridge.route(ctx.qasim, c) else ctx.qasim in
  let fdstate = if c.kind == "finance_fd" then fd_bridge.route(ctx.fd, c) else ctx.fd in
  let state_digest = if c.kind == "finance_qasim" then qstate.state_digest else if c.kind == "finance_fd" then fdstate.registry_hash else content.content_digest(c) in
  let res = { ok: true, accepted_kind: c.kind, state_digest: state_digest, command_result: if c.kind == "finance_qasim" then qstate.command_result else { ok: false, reason: "not a command" } } in
  let next_chain = chain.append(ctx.chain_state, wire_msg, res, state_digest) in
  let _ = store.save_chain(ctx.db, next_chain) in
  { ctx: { chain_state: next_chain, qasim: qstate, fd: fdstate, rbac: ctx.rbac, cas_root: ctx.cas_root, db: ctx.db }, response: res }
}


let send_qasim_command = fn(ctx, from_identity, to_pk, cmd_payload, timestamp_ms) {
  let ev = { evidence_kind: "qasim_command", command: cmd_payload.command_type, payload: cmd_payload }
  let c = { kind: "finance_qasim", channel: cmd_payload.command_type, payload: cmd_payload }
  let w = wire.new_from_content(ctx.chain_state.head, from_identity, to_pk, timestamp_ms, c)
  let bridge_out = qasim_bridge.route(ctx.qasim, c)
  let state_digest = bridge_out.state_digest
  let res = { ok: true, wire: w, content_digest: content.content_digest(c), state_digest: state_digest, command_result: bridge_out.command_result }
  let next_chain = chain.append(ctx.chain_state, ev, res, state_digest)
  let conv = store.conv_id(from_identity.public_key, to_pk)
  let _ = store.save_chain(ctx.db, next_chain)
  let _ = store.save_message(ctx.db, conv, next_chain.count, from_identity.public_key, to_pk, c.kind, content.content_digest(c), w.envelope.envelope_digest, next_chain.head, state_digest, w, timestamp_ms)
  { ctx: { chain_state: next_chain, qasim: bridge_out, fd: ctx.fd, rbac: ctx.rbac, cas_root: ctx.cas_root, db: ctx.db }, response: res }
}

export { initial_ctx, send_evidence, send_qasim_command, send_status, accept_wire }
