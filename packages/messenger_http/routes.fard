import("../messenger_http/handlers") as handlers
import("../messenger_identity/keys") as keys
import("../messenger_core/evidence") as evidence
import("../messenger_core/types") as types
import("../messenger_core/store") as store
import("../messenger_core/replay") as replay
import("../messenger_qasim/channel") as qasim_channel
import("std/str") as str
import("std/list") as list
import("../messenger_identity/identity") as identity
import("../messenger_identity/registry") as registry
import("../messenger_transport/relay_store") as relay_store
import("../messenger_core/artifact_store") as artifact_store
import("../messenger_core/verifier") as verifier
import("../messenger_core/exporter") as exporter
import("std/json") as json

let get_conversation = fn(req, ctx) {
  let prefix = "/conversation/"
  let conv_id = str.slice(req.path, str.len(prefix), str.len(req.path))
  let messages = store.get_messages(ctx.db, conv_id)
  let statuses = store.get_statuses(ctx.db, conv_id)
  let messages_with_statuses = list.map(messages, fn(m) {
    let msg_statuses = store.get_statuses_for_message(ctx.db, conv_id, m.content_digest)
    { seq: m.seq, sender_pk: m.sender_pk, recipient_pk: m.recipient_pk, channel: m.channel, content_digest: m.content_digest, state_digest: m.state_digest, chain_head: m.chain_head, timestamp_ms: m.timestamp_ms, statuses: msg_statuses }
  })
  { ctx: ctx, response: { conversation_id: conv_id, messages: messages_with_statuses, count: list.len(messages) } }
}

let get_conversation_digest = fn(req, ctx) {
  let prefix = "/conversation/"
  let rest = str.slice(req.path, str.len(prefix), str.len(req.path))
  let conv_id = str.slice(rest, 0, str.len(rest) - str.len("/digest"))
  { ctx: ctx, response: store.get_thread_digest(ctx.db, conv_id) }
}

let get_message_by_digest = fn(req, ctx) {
  let prefix = "/message/"
  let digest = str.slice(req.path, str.len(prefix), str.len(req.path))
  { ctx: ctx, response: store.get_message(ctx.db, digest) }
}

let handle = fn(req, ctx) {
  if req.path == "/health" then { ctx: ctx, response: { status: "ok", service: "fard_messenger" } } else
  if req.path == "/identity/register_device" then
    let root = identity.root_identity(req.body.root_seed) in
    let device = identity.device_identity(root, req.body.device_id) in
    let _ = registry.register_device(ctx.db, device) in
    { ctx: ctx, response: { ok: true, root_pk: device.root_pk, device_pk: device.public_key, device_id: device.device_id, root_signature: device.root_signature } }
  else
  if req.path == "/identity/register_session" then
    let root = identity.root_identity(req.body.root_seed) in
    let device = identity.device_identity(root, req.body.device_id) in
    let session = identity.session_identity(device, req.body.session_id, types.now0()) in
    let _ = registry.register_session(ctx.db, session) in
    { ctx: ctx, response: { ok: true, credential: identity.credential(session) } }
  else
  if req.path == "/identity/revoke_session" then
    let _ = registry.revoke_session(ctx.db, req.body.root_pk, req.body.session_id) in
    { ctx: ctx, response: { ok: true, revoked: req.body.session_id } }
  else
  if req.path == "/identity/revoke_device" then
    let _ = registry.revoke_device(ctx.db, req.body.root_pk, req.body.device_id) in
    { ctx: ctx, response: { ok: true, revoked: req.body.device_id } }
  else
  if str.starts_with(req.path, "/identity/devices/") then
    let root_pk = str.slice(req.path, str.len("/identity/devices/"), str.len(req.path)) in
    { ctx: ctx, response: { root_pk: root_pk, devices: registry.get_devices(ctx.db, root_pk) } }
  else
  if str.starts_with(req.path, "/identity/sessions/") then
    let root_pk = str.slice(req.path, str.len("/identity/sessions/"), str.len(req.path)) in
    { ctx: ctx, response: { root_pk: root_pk, sessions: registry.get_sessions(ctx.db, root_pk) } }
  else
  if req.path == "/chain/verify" then { ctx: ctx, response: ctx.chain_state } else
  if req.path == "/conversations" then { ctx: ctx, response: store.get_conversations(ctx.db) } else
  if req.path == "/replay/verify" then { ctx: ctx, response: replay.verify(ctx.db) } else
  if req.path == "/qasim/channels" then { ctx: ctx, response: qasim_channel.list_enabled(ctx.db) } else
  if req.path == "/qasim/invite" then
    let conv = store.conv_id(req.body.participant_a, req.body.participant_b) in
    let _ = qasim_channel.enable(ctx.db, conv, req.body.admin_pk) in
    { ctx: ctx, response: { ok: true, conversation_id: conv, qasim_enabled: true } }
  else
  if str.ends_with(req.path, "/export") && str.starts_with(req.path, "/conversation/") then
   let prefix = "/conversation/" in
   let rest = str.slice(req.path, str.len(prefix), str.len(req.path)) in
   let conv_id = str.slice(rest, 0, str.len(rest) - str.len("/export")) in
   { ctx: ctx, response: exporter.export_conversation(ctx.db, conv_id) }
 else
 if str.ends_with(req.path, "/digest") && str.starts_with(req.path, "/conversation/") then get_conversation_digest(req, ctx) else
  if str.starts_with(req.path, "/conversation/") then get_conversation(req, ctx) else
  if str.starts_with(req.path, "/message/sha256:") && str.ends_with(req.path, "/verify") then
    let rest = str.slice(req.path, str.len("/message/"), str.len(req.path)) in
    let content_digest = str.slice(rest, 0, str.len(rest) - str.len("/verify")) in
    let msg_result = store.get_message(ctx.db, content_digest) in
    if msg_result.ok == false then { ctx: ctx, response: msg_result } else
    let chain = store.load_chain(ctx.db, ctx.chain_state.head) in
    { ctx: ctx, response: verifier.verify_message(ctx.db, msg_result.message, chain.entries) }
  else
  if str.starts_with(req.path, "/message/sha256:") then get_message_by_digest(req, ctx) else
  if req.path == "/message/text" then
    let sender = keys.identity_from_seed(req.body.from_seed) in
    let ev = evidence.draft_text(req.body.text) in
    handlers.send_evidence(ctx, sender, req.body.to_pk, ctx.chain_state.head, types.now0(), ev)
  else
  if req.path == "/message/status" then
    let sender = keys.identity_from_seed(req.body.from_seed) in
    handlers.send_status(ctx, sender, req.body.to_pk, req.body.kind, req.body.target_digest, types.now0())
  else
  if req.path == "/message/payment_request" then
    let sender = keys.identity_from_seed(req.body.from_seed) in
    let ev = evidence.fd_payment_request(req.body.payload) in
    handlers.send_evidence(ctx, sender, req.body.to_pk, ctx.chain_state.head, types.now0(), ev)
  else
  if req.path == "/message/fd_event" then
    let sender = keys.identity_from_seed(req.body.from_seed) in
    let ev = evidence.fd_event(req.body.channel, req.body.payload) in
    handlers.send_evidence(ctx, sender, req.body.to_pk, ctx.chain_state.head, types.now0(), ev)
  else
  if req.path == "/message/qasim_object" then
    let sender = keys.identity_from_seed(req.body.from_seed) in
    let conv = store.conv_id(sender.public_key, req.body.to_pk) in
    let enabled = qasim_channel.is_enabled(ctx.db, conv) in
    if enabled == false then { ctx: ctx, response: { ok: false, error: "qasim channel not enabled for this conversation" } } else
    let ev = evidence.qasim_object(req.body.channel, req.body.payload) in
    handlers.send_evidence(ctx, sender, req.body.to_pk, ctx.chain_state.head, types.now0(), ev)
  else
  if req.path == "/message/qasim_command" then
    let sender = keys.identity_from_seed(req.body.from_seed) in
    let conv = store.conv_id(sender.public_key, req.body.to_pk) in
    let enabled = qasim_channel.is_enabled(ctx.db, conv) in
    if enabled == false then { ctx: ctx, response: { ok: false, error: "qasim channel not enabled for this conversation" } } else
    handlers.send_qasim_command(ctx, sender, req.body.to_pk, req.body.payload, types.now0())
  else
  if req.path == "/artifact/upload" then
    let result = artifact_store.store_artifact(ctx.db, "artifacts", req.body.format, req.body.bytes_text) in
    { ctx: ctx, response: result }
  else
  if str.starts_with(req.path, "/artifact/") && str.ends_with(req.path, "/verify") then
    let rest = str.slice(req.path, str.len("/artifact/"), str.len(req.path)) in
    let art_digest = str.slice(rest, 0, str.len(rest) - str.len("/verify")) in
    { ctx: ctx, response: artifact_store.verify_artifact(ctx.db, "artifacts", art_digest) }
  else
  if str.starts_with(req.path, "/artifact/") then
    let art_digest = str.slice(req.path, str.len("/artifact/"), str.len(req.path)) in
    { ctx: ctx, response: artifact_store.get_artifact(ctx.db, art_digest) }
  else
  if req.path == "/message/photo" then
    let sender = keys.identity_from_seed(req.body.from_seed) in
    let ev = evidence.photo_evidence(req.body.artifact_digest, req.body.artifact_format, req.body.preview_digest, req.body.width, req.body.height, req.body.quality) in
    let out = handlers.send_evidence(ctx, sender, req.body.to_pk, ctx.chain_state.head, types.now0(), ev) in
    let _ = artifact_store.link_message_artifact(ctx.db, out.response.content_digest, req.body.artifact_digest) in
    { ctx: out.ctx, response: out.response }
  else
  if req.path == "/inbox/mark_read" then
    let sender = keys.identity_from_seed(req.body.recipient_seed) in
    let out = handlers.send_status(ctx, sender, req.body.from_pk, "read", req.body.content_digest, types.now0()) in
    { ctx: out.ctx, response: out.response }
  else
  if str.starts_with(req.path, "/inbox/") && str.ends_with(req.path, "/unread") then
    let rest = str.slice(req.path, str.len("/inbox/"), str.len(req.path)) in
    let recipient_pk = str.slice(rest, 0, str.len(rest) - str.len("/unread")) in
    let unread = store.get_unread(ctx.db, recipient_pk) in
    { ctx: ctx, response: { recipient_pk: recipient_pk, unread: unread, unread_count: list.len(unread) } }
  else
  if str.starts_with(req.path, "/inbox/") then
    let recipient_pk = str.slice(req.path, str.len("/inbox/"), str.len(req.path)) in
    let pending = store.get_inbox(ctx.db, recipient_pk) in
    let accepted = store.get_accepted(ctx.db, recipient_pk) in
    let unread = store.get_unread(ctx.db, recipient_pk) in
    { ctx: ctx, response: { recipient_pk: recipient_pk, pending: pending, accepted: accepted, unread_count: list.len(unread) } }
  else
  if req.path == "/send" then
    let session_rows = relay_store.poll(ctx.db, req.body.session_id) in
    let valid = registry.is_session_valid(ctx.db, req.body.root_pk, req.body.session_pk) in
    let sender = identity.session_identity(
      identity.device_identity(identity.root_identity(req.body.root_seed), req.body.device_id),
      req.body.session_id, types.now0()) in
    let ev = evidence.draft_text(req.body.text) in
    let out = handlers.send_evidence(ctx, sender, req.body.to_pk, ctx.chain_state.head, types.now0(), ev) in
    let wire = out.response.wire in
    let _ = relay_store.store_wire(ctx.db, wire) in
    { ctx: out.ctx, response: { ok: true, envelope_digest: wire.envelope.envelope_digest, relayed: true, content_digest: out.response.content_digest } }
  else
  if req.path == "/relay/send" then
    let _ = relay_store.store_wire(ctx.db, req.body) in
    { ctx: ctx, response: { ok: true, envelope_digest: req.body.envelope.envelope_digest, recipient_pk: req.body.envelope.header.recipient_pk } }
  else
  if str.starts_with(req.path, "/relay/poll/") then
    let recipient_pk = str.slice(req.path, str.len("/relay/poll/"), str.len(req.path)) in
    { ctx: ctx, response: { ok: true, messages: relay_store.poll(ctx.db, recipient_pk) } }
  else
  if str.starts_with(req.path, "/relay/status/") then
    let recipient_pk = str.slice(req.path, str.len("/relay/status/"), str.len(req.path)) in
    { ctx: ctx, response: relay_store.status(ctx.db, recipient_pk) }
  else
  if req.path == "/relay/ack" then
    let _ = relay_store.ack(ctx.db, req.body.recipient_pk, req.body.envelope_digest) in
    { ctx: ctx, response: { ok: true, acked: req.body.envelope_digest } }
  else
  if req.path == "/relay/verify" then
    { ctx: ctx, response: relay_store.verify(ctx.db) }
  else
  if req.path == "/wire/accept" then handlers.accept_wire(ctx, req.body) else
  { ctx: ctx, response: { ok: false, error: "route not found" } }
}

export { handle }
