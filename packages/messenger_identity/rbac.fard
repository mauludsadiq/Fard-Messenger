import("std/str") as str
import("../messenger_core/digest") as digest
import("std/list") as list

let key_hash = fn(raw) { digest.digest_text(str.concat(["apikey:", raw])) }
let new_table = fn(admin_key) { { keys: [{ label: "bootstrap-admin", role: "admin", hash: key_hash(admin_key), revoked: false, expiry_ts: 0 }] } }
let role_allows = fn(role,action) {
  if role == "admin" then true else
  if role == "trader" then (action == "send" || action == "route_qasim" || action == "route_fd" || action == "read") else
  if role == "risk" then (action == "route_qasim_rule" || action == "read") else
  if role == "readonly" then action == "read" else false
}
let authenticate = fn(table,raw_key,action,now_ts) {
  let h = key_hash(raw_key) in
  let matches = list.filter(table.keys, fn(k) { k.hash == h && k.revoked == false && (k.expiry_ts == 0 || k.expiry_ts > now_ts) }) in
  let k = list.get(matches,0) in
  if list.len(matches) == 0 then { ok: false, reason: "forbidden" } else
  { ok: role_allows(k.role,action), role: k.role, key_hash: h }
}
let add_key = fn(table,label,role,raw_key,expiry_ts) {
  { keys: list.concat([table.keys,[{ label: label, role: role, hash: key_hash(raw_key), revoked: false, expiry_ts: expiry_ts }]]) }
}

export { key_hash, new_table, role_allows, authenticate, add_key }
