import("../packages/messenger_core/chain") as chain
import("../packages/messenger_core/digest") as digest
import("std/list") as list

test "genesis chain has count zero" {
  chain.new_chain("GENESIS").count == 0
}

test "append increments count" {
  let c0 = chain.new_chain("GENESIS")
  let c1 = chain.append(c0, {req: 1}, {res: 1}, digest.digest_text("state1"))
  c1.count == 1
}

test "two appends chain correctly" {
  let c0 = chain.new_chain("GENESIS")
  let c1 = chain.append(c0, {req: 1}, {res: 1}, digest.digest_text("state1"))
  let c2 = chain.append(c1, {req: 2}, {res: 2}, digest.digest_text("state2"))
  c2.count == 2
}

test "chain verify passes" {
  let c0 = chain.new_chain("GENESIS")
  let c1 = chain.append(c0, {req: 1}, {res: 1}, digest.digest_text("state1"))
  let c2 = chain.append(c1, {req: 2}, {res: 2}, digest.digest_text("state2"))
  chain.verify(c2).ok
}

test "head changes on each append" {
  let c0 = chain.new_chain("GENESIS")
  let c1 = chain.append(c0, {req: 1}, {res: 1}, digest.digest_text("s1"))
  c0.head != c1.head
}
