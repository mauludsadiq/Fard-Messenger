import("../packages/messenger_core/evidence") as evidence
import("../packages/messenger_core/content") as content
import("../packages/messenger_core/digest") as digest
import("../packages/messenger_identity/keys") as keys
import("../packages/messenger_core/wire") as wire
import("std/list") as list

test "draft text collapses to text content" {
  let c = evidence.collapse(evidence.draft_text("hello world"), "cas")
  c.kind == "text"
}

test "content digest verifies" {
  let c = content.text("hello")
  content.verify(c, content.content_digest(c))
}

test "wire roundtrip decrypts correctly" {
  let a = keys.identity_from_seed("a")
  let b = keys.identity_from_seed("b")
  let c = content.text("hello")
  let w = wire.new_from_content(digest.zero_digest(), a, b.public_key, 0, c)
  let o = wire.decrypt_content(w)
  o.ok
}

test "fd evidence collapses to finance_fd" {
  let e = evidence.fd_event("deposit", { kind: "fd_event_v1" })
  let c = evidence.collapse(e, "cas")
  c.kind == "finance_fd"
}

test "qasim evidence collapses to finance_qasim" {
  let e = evidence.qasim_object("fill", { kind: "qasim_signed_object_v1" })
  let c = evidence.collapse(e, "cas")
  c.kind == "finance_qasim"
}
